{
  "name": "orchestrix-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <27"
  },
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
