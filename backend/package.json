    "express": "5.3.0",
    "google-auth-library": "11.3.4",
    "mongoose": "9.12.2",
    "morgan": "1.12.1"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "nodemon": "3.1.11"
  }
